---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const projects = await getCollection("projects");
const b = import.meta.env.BASE_URL;
---

<Layout title="Research">
  <p class="eyebrow">Manik Bansal</p>
  <h1>Research</h1>
  <p class="lead">
    Connecting microstructure and mechanics to understand failure in engineered
    materials and biological tissues.
  </p>
  <section class="section" id="projects">
    <h2>Research projects</h2>
    <p>Methods and research questions across materials and biomechanics.</p>
    <div class="grid">
      {projects.map((project) => (
        <article class="card">
          <p class="eyebrow">{project.data.theme}</p>
          <h3>{project.data.title}</h3>
          <p>{project.data.summary}</p>
          <a href={`${b}projects/${project.id}/`}>Explore project →</a>
        </article>
      ))}
    </div>
  </section>
  <section class="section">
    <h2>A shared computational toolkit</h2>
    <p>
      Finite element analysis, scientific computing, and high-performance
      computing connect these research areas. Fluid-structure interaction is a
      stated research theme; supporting project details remain to be added.
    </p>
    <p class="placeholder">
      Placeholder — future research statement, funding plans, and approved
      research figures pending author review.
    </p>
  </section>
</Layout>
