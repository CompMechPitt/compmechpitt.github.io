---
import Layout from "../layouts/Layout.astro";
const b = import.meta.env.BASE_URL;
---

<Layout title="Research">
  <p class="eyebrow">Manik Bansal</p>
  <h1>Research</h1>
  <p class="lead">
    Connecting microstructure and mechanics to understand failure in engineered
    materials and biological tissues.
  </p>
  <div class="grid">
    <article class="card">
      <h2>Composite fracture</h2>
      <p>
        Multiscale modeling, stochastic fracture, and XFEM for heterogeneous
        particulate materials.
      </p>
      <a href={`${b}projects/composites/`}>Materials research →</a>
    </article>
    <article class="card">
      <h2>Ocular biomechanics</h2>
      <p>
        Collagen architecture, fiber-based models, and axon-centric measures of
        mechanical insult.
      </p>
      <a href={`${b}projects/ocular/`}>Ocular research →</a>
    </article>
    <article class="card">
      <h2>Brain biomechanics</h2>
      <p>
        Computational head models and physics-based approaches to blast injury.
      </p>
      <a href={`${b}projects/brain/`}>Brain research →</a>
    </article>
  </div>
  <section class="section">
    <h2>A shared computational toolkit</h2>
    <p>
      Finite element analysis, scientific computing, and high-performance
      computing connect these research areas. Fluid-structure interaction is a
      stated research theme; supporting project details remain to be added.
    </p>
    <p class="placeholder">
      Placeholder — future research statement, funding plans, and approved
      research figures pending author review.
    </p>
  </section>
</Layout>
