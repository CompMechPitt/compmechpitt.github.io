---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
const projects = await getCollection("projects");
---

<Layout title="Projects">
  <p class="eyebrow">Selected work</p>
  <h1>Research in practice.</h1>
  <p class="lead">
    Methods and research questions across materials and biomechanics.
  </p>
  <div class="grid">
    {projects.map((p) => (
      <article class="card">
        <p class="eyebrow">{p.data.theme}</p>
        <h2>{p.data.title}</h2>
        <p>{p.data.summary}</p>
        <a href={`${import.meta.env.BASE_URL}projects/${p.id}/`}>
          Explore project →
        </a>
      </article>
    ))}
  </div>
</Layout>
