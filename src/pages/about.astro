---
import Layout from "../layouts/Layout.astro";
import ExperienceLogos from "../components/ExperienceLogos.astro";
const b = import.meta.env.BASE_URL;
---

<Layout title="About">
  <p class="eyebrow">Manik Bansal</p>
  <h1>About</h1>
  <p class="lead">
    I work at the intersection of computational solid mechanics, injury
    biomechanics, and multiscale modeling.
  </p>
  <p>
    My research spans fracture in heterogeneous materials, collagen architecture
    in ocular tissues, and computational modeling of blast-induced brain injury.
  </p>
  <section class="section">
    <h2>Research experience</h2>
    <div class="timeline">
      <div>
        <p class="eyebrow">November 2022 – Present, as listed in CV</p>
        <h2>Postdoctoral Researcher</h2>
        <p>Robert Morris University · Department of Engineering</p>
        <p>
          High-fidelity human head models for blast-induced traumatic brain
          injury prediction.
        </p>
      </div>
      <ExperienceLogos
        logos={[
          { file: "rmu.png", name: "Robert Morris University" },
          {
            file: "panther.png",
            name: "PANTHER research program",
          },
          { file: "onr.png", name: "Office of Naval Research" },
        ]}
      />
    </div>
    <div class="timeline">
      <div>
        <p class="eyebrow">February 2020 – October 2022</p>
        <h2>Postdoctoral Associate</h2>
        <p>University of Pittsburgh · Department of Ophthalmology</p>
        <p>
          Micromechanics-based numerical modeling of scleral collagen
          architecture.
        </p>
      </div>
      <ExperienceLogos
        logos={[
          {
            file: "pitt.png",
            name: "University of Pittsburgh",
          },
          {
            file: "nih.png",
            name: "National Institutes of Health",
          },
        ]}
      />
    </div>
    <div class="timeline">
      <div>
        <p class="eyebrow">November 2014 – September 2019</p>
        <h2>Senior Research Fellow</h2>
        <p>
          Indian Institute of Technology Roorkee · Mechanical and Industrial
          Engineering
        </p>
        <p>Multiscale XFEM frameworks for heterogeneous materials.</p>
      </div>
      <ExperienceLogos
        logos={[
          {
            file: "iit-roorkee.png",
            name: "Indian Institute of Technology Roorkee",
          },
          {
            file: "csir.png",
            name: "Council of Scientific and Industrial Research",
          },
          {
            file: "brns.png",
            name: "Board of Research in Nuclear Sciences",
          },
          {
            file: "barc.svg",
            name: "Bhabha Atomic Research Centre",
          },
        ]}
      />
    </div>
  </section>
  <section class="section">
    <h2>Education</h2>
    <div class="timeline">
      <div>
        <p class="eyebrow">2014 – 2019</p>
        <h2>PhD, Mechanical Engineering (Design)</h2>
        <p>Indian Institute of Technology Roorkee</p>
      </div>
      <ExperienceLogos
        logos={[
          {
            file: "iit-roorkee.png",
            name: "Indian Institute of Technology Roorkee",
          },
        ]}
        ariaLabel="Degree institution"
      />
    </div>
    <div class="timeline">
      <div>
        <p class="eyebrow">2011 – 2013</p>
        <h2>M.Tech, CAD/CAM</h2>
        <p>Vellore Institute of Technology</p>
      </div>
      <ExperienceLogos
        logos={[
          {
            file: "vit.webp",
            name: "Vellore Institute of Technology",
          },
        ]}
        ariaLabel="Degree institution"
      />
    </div>
    <div class="timeline">
      <div>
        <p class="eyebrow">2005 – 2009</p>
        <h2>B.E., Mechanical Engineering</h2>
        <p>University of Pune</p>
      </div>
      <ExperienceLogos
        logos={[
          {
            file: "university-of-pune.jpg",
            name: "University of Pune",
          },
        ]}
        ariaLabel="Degree institution"
      />
    </div>
  </section>
  <section class="section" id="cv-resume">
    <h2>CV &amp; resume</h2>
    <p class="lead">Download the academic CV or the draft industry resume.</p>
    <div class="paths">
      <section class="path">
        <p class="eyebrow">Academic applications</p>
        <h3>Curriculum vitae</h3>
        <p>
          CV supplied by the author, dated May 20, 2026; referee section removed
          for public release.
        </p>
        <a class="button" href={`${b}downloads/ManikBansal-CV.pdf`} download>
          Download academic CV (PDF)
        </a>
        <p class="placeholder">
          Public version: referee contact information has been removed. Other
          personal details are retained with author approval.
        </p>
      </section>
      <section class="path" id="industry">
        <p class="eyebrow">Engineering &amp; industry</p>
        <h3>Industry resume</h3>
        <p>
          A concise draft derived from the supplied CV, emphasizing simulation,
          programming, and engineering work.
        </p>
        <a
          class="button"
          href={`${b}downloads/ManikBansal-Industry-Resume.pdf`}
          download
        >
          Download draft resume (PDF)
        </a>
        <p class="placeholder">
          Draft for author review — target role and tailored achievements
          pending.
        </p>
      </section>
    </div>
  </section>
</Layout>

<style>
  .timeline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(340px, 38vw, 420px);
    align-items: center;
    gap: 36px;
    padding: 28px 0;
  }
  @media (max-width: 850px) {
    .timeline {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .timeline :global(.experience-logos) {
      max-width: 380px;
    }
  }
</style>
