---
import Layout from "../layouts/Layout.astro";

const journalReviews = [
  {
    journal: "International Journal of Damage Mechanics",
    years: "2020",
    cover: "media/journal-covers/international-journal-damage-mechanics.webp",
  },
  {
    journal: "Engineering Structures",
    years: "2022, 2024",
    cover: "media/journal-covers/engineering-structures.webp",
  },
  {
    journal: "Applied Composite Materials",
    years: "2024, 2025",
    cover: "media/journal-covers/applied-composite-materials.jpg",
  },
  {
    journal: "Experimental Eye Research",
    years: "2025",
    cover: "media/journal-covers/experimental-eye-research.jpg",
  },
  {
    journal: "Progress in Additive Manufacturing",
    years: "2025",
    cover: "media/journal-covers/progress-additive-manufacturing.jpg",
  },
  {
    journal: "Military Medicine",
    years: "2025, 2026–ongoing",
    cover: "media/journal-covers/military-medicine.jpg",
  },
  {
    journal: "Frontiers in Bioengineering",
    years: "2026–ongoing",
    cover: "media/journal-covers/frontiers-bioengineering.jpg",
  },
];
---

<Layout title="Awards & Service">
  <p class="eyebrow">Manik Bansal</p>
  <h1>Awards & Service</h1>
  <p class="lead">
    Selected recognition and professional contributions documented in the
    supplied CV.
  </p>
  <section class="section">
    <h2>Selected recognition</h2>
    <ul>
      <li>
        Recognition awards for completion of grant-funded projects, Robert
        Morris University Research and Grant Expo, 2025.
      </li>
      <li>MHRD Fellowship, IIT Roorkee, 2017–2019.</li>
      <li>Senior Research Fellowship, IIT Roorkee, 2014–2017.</li>
      <li>
        Second overall rank, M.Tech CAD/CAM, Vellore Institute of Technology,
        2013.
      </li>
      <li>
        Merit scholarships, Vellore Institute of Technology, 2011 and 2012.
      </li>
    </ul>
  </section>
  <section class="section">
    <h2>Peer review & community</h2>
    <div class="service-group">
      <h3>Conference Abstract review</h3>
      <ul class="service-list">
        <li>
          Summer Biomechanics, Bioengineering and Biotransport Conference (SB3C)
          —{" "}
          <strong>
            <em>2022, 2025</em>
          </strong>
        </li>
        <li>
          American Society of Biomechanics (ASB) —
          <strong>
            <em>2025</em>
          </strong>
        </li>
      </ul>
    </div>
    <div class="service-group">
      <h3>Journal Reviewing</h3>
      <ul class="journal-shelf" aria-label="Journals reviewed">
        {journalReviews.map((review) => (
          <li class="journal-book">
            <div class="journal-book__cover">
              <img
                src={`${import.meta.env.BASE_URL}${review.cover}`}
                alt={`Cover of ${review.journal}`}
                width="150"
                height="200"
                loading="lazy"
                decoding="async"
              />
            </div>
            <p>{review.journal}</p>
            <strong>
              <em>{review.years}</em>
            </strong>
          </li>
        ))}
      </ul>
    </div>
    <div class="service-group">
      <h3>Co-moderator</h3>
      <article class="moderator-feature">
        <div class="moderator-feature__cover">
          <img
            src={`${import.meta.env.BASE_URL}media/journal-covers/journal-acoustical-society-america.jpg`}
            alt="Cover of The Journal of the Acoustical Society of America"
            width="170"
            height="225"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div>
          <p class="eyebrow">Acoustical Society of America webinar</p>
          <p class="moderator-feature__topic">
            <strong>
              “Cavitation-Induced Brain Injury: Mechanisms and Modeling”
            </strong>
          </p>
          <p>
            <strong>
              <em>November 20, 2025</em>
            </strong>
          </p>
        </div>
      </article>
    </div>
  </section>
</Layout>
