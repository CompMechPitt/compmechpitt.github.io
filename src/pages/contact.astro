---
import Layout from "../layouts/Layout.astro";

const profiles = [
  {
    name: "LinkedIn",
    detail: "Professional network",
    mark: "in",
    className: "linkedin",
    url: "https://www.linkedin.com/in/manikbansalphdiitr/",
  },
  {
    name: "Google Scholar",
    detail: "Publications and citations",
    mark: "G",
    className: "scholar",
    url: "https://scholar.google.com/citations?user=Fgh0WtUAAAAJ&hl=en",
  },
  {
    name: "ORCID",
    detail: "Researcher identifier",
    mark: "iD",
    className: "orcid",
    url: "https://orcid.org/0000-0002-2754-2497",
  },
  {
    name: "GitHub",
    detail: "Code and projects",
    mark: "GH",
    className: "github",
    url: "https://github.com/CompMechPitt",
  },
];
---

<Layout title="Contact">
  <p class="eyebrow">Manik Bansal</p>
  <h1>Contact</h1>
  <p class="lead">
    Let’s connect about computational mechanics, biomechanics, research
    collaborations, or engineering opportunities.
  </p>
  <section class="section">
    <h2>Email</h2>
    <p>
      <a href="mailto:manikbansal.iitr@gmail.com">manikbansal.iitr@gmail.com</a>
    </p>
    <h2>Professional profiles</h2>
    <ul class="profiles">
      {profiles.map((profile) => (
        <li>
          <a href={profile.url} target="_blank" rel="noopener noreferrer">
            <span
              class:list={["profile-mark", profile.className]}
              aria-hidden="true"
            >
              {profile.mark}
            </span>
            <span class="profile-copy">
              <strong>{profile.name}</strong>
              <small>{profile.detail}</small>
            </span>
            <span class="profile-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .profiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    max-width: 900px;
  }
  .profiles a {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 108px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fffefa;
    box-shadow: 0 2px 8px rgb(24 54 57 / 4%);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }
  .profiles a:hover {
    border-color: #9eaaa1;
    box-shadow: 0 8px 20px rgb(24 54 57 / 9%);
    transform: translateY(-3px);
  }
  .profiles a:focus-visible {
    outline-offset: 4px;
  }
  .profile-mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    color: white;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.08em;
  }
  .linkedin {
    background: #0a66c2;
  }
  .scholar {
    background: #406fb4;
    font-family: Georgia, serif;
    font-size: 25px;
    font-weight: 700;
  }
  .orcid {
    background: #a6ce39;
    color: #183639;
  }
  .github {
    background: #24292f;
    font-size: 16px;
    letter-spacing: -0.1em;
  }
  .profile-copy {
    display: grid;
    gap: 2px;
  }
  .profile-copy strong {
    font-size: 17px;
    line-height: 1.3;
  }
  .profile-copy small {
    color: var(--muted);
    font-size: 13px;
  }
  .profile-arrow {
    margin-left: auto;
    color: var(--muted);
    font-size: 20px;
    line-height: 1;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }
  .profiles a:hover .profile-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  @media (max-width: 640px) {
    .profiles {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .profiles a {
      min-height: 92px;
      padding: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .profiles a {
      transition: none;
    }
    .profile-arrow {
      transition: none;
    }
  }
</style>
