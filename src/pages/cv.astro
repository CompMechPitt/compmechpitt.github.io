---
import Layout from "../layouts/Layout.astro";
const destination = `${import.meta.env.BASE_URL}about/#cv-resume`;
---

<Layout title="CV & Resume">
  <h1>CV &amp; resume</h1>
  <p>The CV and resume downloads are now part of the About page.</p>
  <p>
    <a class="button" href={destination}>
      View CV &amp; resume on About →
    </a>
  </p>
</Layout>
