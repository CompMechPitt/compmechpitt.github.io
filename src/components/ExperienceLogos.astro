---
interface Props {
  logos: { file: string; name: string }[];
  ariaLabel?: string;
}
const { logos, ariaLabel = "Research institutions and sponsors" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul
  class:list={[
    "experience-logos",
    {
      "four-logos": logos.length === 4,
      "two-logos": logos.length === 2,
      "one-logo": logos.length === 1,
    },
  ]}
  aria-label={ariaLabel}
>
  {logos.map(({ file, name }) => (
    <li>
      <div class="logo-image">
        <img
          src={`${base}media/logos/${file}`}
          alt={`${name} logo`}
          class:list={[
            {
              "dark-logo": file === "vit.webp",
              "blend-logo": file === "university-of-pune.jpg",
            },
          ]}
          loading="lazy"
          decoding="async"
        />
      </div>
    </li>
  ))}
</ul>

<style>
  .experience-logos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: 20px 16px;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }
  .two-logos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .one-logo {
    grid-template-columns: 1fr;
    max-width: 340px;
    justify-self: center;
  }
  .one-logo .logo-image {
    height: 132px;
  }
  .one-logo img {
    max-height: 124px;
  }
  .four-logos li:first-child {
    grid-column: 1 / -1;
  }
  .four-logos li:first-child .logo-image {
    height: 40px;
  }
  .four-logos li:first-child img {
    max-width: 280px;
    max-height: 40px;
  }
  li {
    text-align: center;
  }
  .logo-image {
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  img {
    display: block;
    max-width: 100%;
    max-height: 84px;
    width: auto;
    height: auto;
  }
  .dark-logo {
    filter: brightness(0);
  }
  .blend-logo {
    mix-blend-mode: multiply;
  }
  @media (min-width: 851px) {
    .experience-logos:not(.one-logo) .logo-image {
      height: 116px;
    }
    .experience-logos:not(.one-logo) img {
      max-height: 112px;
    }
    .experience-logos.four-logos li:first-child .logo-image {
      height: 66px;
    }
    .experience-logos.four-logos li:first-child img {
      max-width: 360px;
      max-height: 66px;
    }
  }
</style>
