---
interface Props {
  logos: { file: string; name: string; label: string }[];
  ariaLabel?: string;
}
const { logos, ariaLabel = "Research institutions and sponsors" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul
  class:list={[
    "experience-logos",
    {
      "four-logos": logos.length === 4,
      "two-logos": logos.length === 2,
      "one-logo": logos.length === 1,
    },
  ]}
  aria-label={ariaLabel}
>
  {logos.map(({ file, name, label }) => (
    <li>
      <div class:list={["logo-image", { "inverse-logo": file === "vit.webp" }]}>
        <img
          src={`${base}media/logos/${file}`}
          alt={`${name} logo`}
          loading="lazy"
          decoding="async"
        />
      </div>
      <span>{label}</span>
    </li>
  ))}
</ul>

<style>
  .experience-logos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: 20px 16px;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }
  .two-logos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .one-logo {
    grid-template-columns: 1fr;
    max-width: 220px;
    justify-self: center;
  }
  .four-logos li:first-child {
    grid-column: 1 / -1;
  }
  .four-logos li:first-child .logo-image {
    height: 40px;
  }
  .four-logos li:first-child img {
    max-width: 280px;
    max-height: 40px;
  }
  li {
    text-align: center;
  }
  .logo-image {
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .inverse-logo {
    height: 76px;
    padding: 14px;
    border-radius: 4px;
    background: #183639;
  }
  img {
    display: block;
    max-width: 100%;
    max-height: 84px;
    width: auto;
    height: auto;
  }
  span {
    display: block;
    margin-top: 10px;
    font-size: 11px;
    line-height: 1.4;
    color: var(--muted);
  }
</style>
