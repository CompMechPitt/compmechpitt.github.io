---
interface Props {
  logos: { file: string; name: string; label: string }[];
}
const { logos } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul
  class:list={[
    "experience-logos",
    { "four-logos": logos.length === 4, "two-logos": logos.length === 2 },
  ]}
  aria-label="Research institutions and sponsors"
>
  {logos.map(({ file, name, label }) => (
    <li>
      <div class="logo-image">
        <img
          src={`${base}media/logos/${file}`}
          alt={`${name} logo`}
          loading="lazy"
          decoding="async"
        />
      </div>
      <span>{label}</span>
    </li>
  ))}
</ul>

<style>
  .experience-logos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: 20px 16px;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }
  .two-logos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .four-logos li:first-child {
    grid-column: 1 / -1;
  }
  .four-logos li:first-child .logo-image {
    height: 40px;
  }
  .four-logos li:first-child img {
    max-width: 280px;
    max-height: 40px;
  }
  li {
    text-align: center;
  }
  .logo-image {
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  img {
    display: block;
    max-width: 100%;
    max-height: 84px;
    width: auto;
    height: auto;
  }
  span {
    display: block;
    margin-top: 10px;
    font-size: 11px;
    line-height: 1.4;
    color: var(--muted);
  }
</style>
